    "definition": "{\n  \"StartAt\": \"PipelineStepChoice\",\n  \"States\": {\n    \"CompressionJob\": {\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\n            \"States.ALL\"\n          ],\n          \"Next\": \"NotifyError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ],\n      \"Next\": \"WaitForCompressionCompletion\",\n      \"Parameters\": {\n        \"AppSpecification\": {\n          \"ContainerEntrypoint\": [\n            \"python3\",\n            \"compress.py\"\n          ],\n          \"ImageUri.$\": \"$.compressorImageUri\"\n        },\n        \"Environment\": {\n          \"AWS_DEFAULT_REGION\": \"us-west-2\",\n          \"PYTHONUNBUFFERED\": \"1\"\n        },\n        \"ProcessingInputs\": [\n          {\n            \"AppManaged\": false,\n            \"InputName\": \"gaussian-model\",\n            \"S3Input\": {\n              \"LocalPath\": \"/opt/ml/processing/input\",\n              \"S3DataType\": \"S3Prefix\",\n              \"S3InputMode\": \"File\",\n              \"S3Uri.$\": \"$.gaussianOutputS3Uri\"\n            }\n          }\n        ],\n        \"ProcessingJobName.$\": \"States.Format('{}-compression', $.jobName)\",\n        \"ProcessingOutputConfig\": {\n          \"Outputs\": [\n            {\n              \"AppManaged\": false,\n              \"OutputName\": \"compressed-model\",\n              \"S3Output\": {\n                \"LocalPath\": \"/opt/ml/processing/output\",\n                \"S3UploadMode\": \"EndOfJob\",\n                \"S3Uri.$\": \"$.compressedOutputS3Uri\"\n              }\n            }\n          ]\n        },\n        \"ProcessingResources\": {\n          \"ClusterConfig\": {\n            \"InstanceCount\": 1,\n            \"InstanceType\": \"ml.g4dn.xlarge\",\n            \"VolumeSizeInGB\": 50\n          }\n        },\n        \"RoleArn\": \"arn:aws:iam::975050048887:role/Spaceport-SageMaker-Role-staging\",\n        \"Tags\": [\n          {\n            \"Key\": \"Project\",\n            \"Value\": \"Spaceport\"\n          },\n          {\n            \"Key\": \"Component\",\n            \"Value\": \"Compression\"\n          },\n          {\n            \"Key\": \"Environment\",\n            \"Value\": \"staging\"\n          }\n        ]\n      },\n      \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:createProcessingJob\",\n      \"ResultPath\": \"$.compressionResult\",\n      \"Type\": \"Task\"\n    },\n    \"GaussianTrainingJob\": {\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\n            \"States.ALL\"\n          ],\n          \"Next\": \"NotifyError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ],\n      \"Next\": \"WaitForGaussianCompletion\",\n      \"Parameters\": {\n        \"AlgorithmSpecification\": {\n          \"TrainingImage.$\": \"$.gaussianImageUri\",\n          \"TrainingInputMode\": \"File\"\n        },\n        \"Environment\": {\n          \"APPEARANCE_EMBED_DIM.$\": \"$.APPEARANCE_EMBED_DIM\",\n          \"AWS_DEFAULT_REGION\": \"us-west-2\",\n          \"BACKGROUND_APPEARANCE_MODE.$\": \"$.BACKGROUND_APPEARANCE_MODE\",\n          \"BACKGROUND_SELECTION_MAX_FRAMES.$\": \"$.BACKGROUND_SELECTION_MAX_FRAMES\",\n          \"BACKGROUND_SELECTION_STRIDE.$\": \"$.BACKGROUND_SELECTION_STRIDE\",\n          \"BACKGROUND_SKYBOX_HEIGHT.$\": \"$.BACKGROUND_SKYBOX_HEIGHT\",\n          \"BACKGROUND_SKYBOX_QUALITY.$\": \"$.BACKGROUND_SKYBOX_QUALITY\",\n          \"BACKGROUND_SKYBOX_WIDTH.$\": \"$.BACKGROUND_SKYBOX_WIDTH\",\n          \"BG_SH_DEGREE.$\": \"$.BG_SH_DEGREE\",\n          \"BILATERAL_PROCESSING.$\": \"$.BILATERAL_PROCESSING\",\n          \"COMMERCIAL_LICENSE\": \"true\",\n          \"CUDA_HOME\": \"/usr/local/cuda\",\n          \"CULL_ALPHA_THRESH.$\": \"$.CULL_ALPHA_THRESH\",\n          \"CULL_SCALE_THRESH.$\": \"$.CULL_SCALE_THRESH\",\n          \"ENABLE_ALPHA_LOSS.$\": \"$.ENABLE_ALPHA_LOSS\",\n          \"ENABLE_BG_MODEL.$\": \"$.ENABLE_BG_MODEL\",\n          \"ENABLE_ROBUST_MASK.$\