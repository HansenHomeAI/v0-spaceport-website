       \"USE_SCALE_REGULARIZATION.$\": \"$.USE_SCALE_REGULARIZATION\"\n        },\n        \"InputDataConfig\": [\n          {\n            \"ChannelName\": \"training\",\n            \"DataSource\": {\n              \"S3DataSource\": {\n                \"S3DataDistributionType\": \"FullyReplicated\",\n                \"S3DataType\": \"S3Prefix\",\n                \"S3Uri.$\": \"$.colmapOutputS3Uri\"\n              }\n            }\n          }\n        ],\n        \"OutputDataConfig\": {\n          \"S3OutputPath.$\": \"$.gaussianOutputS3Uri\"\n        },\n        \"ResourceConfig\": {\n          \"InstanceCount\": 1,\n          \"InstanceType\": \"ml.g5.2xlarge\",\n          \"VolumeSizeInGB\": 100\n        },\n        \"RoleArn\": \"arn:aws:iam::975050048887:role/Spaceport-SageMaker-Role-staging\",\n        \"StoppingCondition\": {\n          \"MaxRuntimeInSeconds\": 14400\n        },\n        \"Tags\": [\n          {\n            \"Key\": \"Project\",\n            \"Value\": \"Spaceport\"\n          },\n          {\n            \"Key\": \"Component\",\n            \"Value\": \"3DGS\"\n          },\n          {\n            \"Key\": \"Environment\",\n            \"Value\": \"staging\"\n          }\n        ],\n        \"TrainingJobName.$\": \"States.Format('{}-3dgs', $.jobName)\"\n      },\n      \"Resource\": \"arn:aws:states:::aws-sdk:sagemaker:createTrainingJob\",\n      \"ResultPath\": \"$.gaussianResult\",\n      \"Type\": \"Task\"\n    },\n    \"IsCompressionComplete\": {\n      \"Choices\": [\n        {\n          \"Next\": \"NotifyUser\",\n          \"StringEquals\": \"Completed\",\n          \"Variable\": \"$.compressionStatus.ProcessingJobStatus\"\n        },\n        {\n          \"Next\": \"NotifyError\",\n          \"StringEquals\": \"Failed\",\n          \"Variable\": \"$.compressionStatus.ProcessingJobStatus\"\n        }\n      ],\n      \"Default\": \"WaitForCompression\",\n      \"Type\": \"Choice\"\n    },\n    \"IsGaussianComplete\": {\n      \"Choices\": [\n        {\n          \"Next\": \"CompressionJob\",\n          \"StringEquals\": \"Completed\",\n          \"Variable\": \"$.gaussianStatus.TrainingJobStatus\"\n        },\n        {\n          \"Next\": \"NotifyError\",\n          \"StringEquals\": \"Failed\",\n          \"Variable\": \"$.gaussianStatus.TrainingJobStatus\"\n        }\n      ],\n      \"Default\": \"WaitForGaussian\",\n      \"Type\": \"Choice\"\n    },\n    \"IsSfMComplete\": {\n      \"Choices\": [\n        {\n          \"Next\": \"GaussianTrainingJob\",\n          \"StringEquals\": \"Completed\",\n          \"Variable\": \"$.sfmStatus.ProcessingJobStatus\"\n        },\n        {\n          \"Next\": \"NotifyError\",\n          \"StringEquals\": \"Failed\",\n          \"Variable\": \"$.sfmStatus.ProcessingJobStatus\"\n        }\n      ],\n      \"Default\": \"WaitForSfM\",\n      \"Type\": \"Choice\"\n    },\n    \"NotifyError\": {\n      \"End\": true,\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-west-2:975050048887:function:Spaceport-MLNotification-staging\",\n        \"Payload\": {\n          \"email.$\": \"$.email\",\n          \"jobId.$\": \"$.jobId\",\n          \"s3Url.$\": \"$.s3Url\",\n          \"state.$\": \"$\",\n          \"status\": \"failed\"\n        }\n      },\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"Retry\": [\n        {\n          \"BackoffRate\": 2,\n          \"ErrorEquals\": [\n            \"Lambda.ClientExecutionTimeoutException\",\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\"\n          ],\n          \"IntervalSeconds\": 2,\n          \"MaxAttempts\": 6\n        }\n      ],\n      \"Type\": \"Task\"\n    },\n    \"NotifyUser\": {\n      \"End\": true,\n      \"Parameters\": {\n        \"FunctionName\": \"arn:aws:lambda:us-west-2:975050048887:function:Spaceport-MLNotification-staging\",\n        \"Payload\": {\n          \"compressedOutputS3Uri.$\": \"$.compressedOutputS3Uri\",\n          \"email.$\": \"$.email\",\n          \"jobId.$\": \"$.jobId\",\n          \"s3Url.$\": \"$.s3Url\",\n          \"status\": \"completed\"\n        }\n      },\n      \"Resource\": \"arn:aws:states:::lambda:invoke\",\n      \"ResultPath\": \"$.notificationResult\",\n      \"Retry\": [\n        {\n          \"BackoffRate\": 2,\n          \"ErrorEquals\": [\n            \"Lambda.ClientExecutionTimeoutException\",\n            \"Lambda.ServiceException\",\n            \"Lambda.AWSLambdaException\",\n            \"Lambda.SdkClientException\"\n          ],\n          \"IntervalSeconds\": 2,\n          \"MaxAttempts\": 6\n        }\n      ],\n      \"Type\": \"Task\"\n    },\n    \"PipelineStepChoice\": {\n      \"Choices\": [\n        {\n          \"Next\": \"SfMProcessingJob\",\n          \"StringEquals\": \"sfm\",\n          \"Variable\": \"$.pipelineStep\"\n        },\n        {\n          \"Next\": \"GaussianTrainingJob\",\n          \"StringEquals\": \"3dgs\",\n          \"Variable\": \"$.pipelineStep\"\n        },\n        {\n          \"Next\": \"CompressionJob\",\n          \"StringEquals\": \"compression\",\n          \"Variable\": \"$.pipelineStep\"\n        }\n      ],\n      \"Default\": \"SfMProcessingJob\",\n      \"Type\": \"Choice\"\n    },\n    \"SfMProcessingJob\": {\n      \"Catch\": [\n        {\n          \"ErrorEquals\": [\n            \"States.ALL\"\n          ],\n          \"Next\": \"NotifyError\",\n          \"ResultPath\": \"$.error\"\n        }\n      ],\n      \"Next\": \"WaitForSfMCompletion\",\n      \"Parameters\": {\n        \"AppSpecification\": {\n          \"ContainerEntrypoint\": [\n            \"/opt/ml/code/run_sfm.sh\"\n          ],\n          \"ImageUri.$\": \"$.sfmImageUri\"\n        },\n        \"Environment\": {\n          \"AWS_DEFAULT_REGION\": \"us-west-2\",\n          \"COLMAP_BUNDLE_ADJUSTER_TIMEOUT_SECONDS\": \"43200\",\n          \"COLMAP_MONOLITHIC_MAPPER_TIME